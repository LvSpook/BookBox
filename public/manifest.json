{
  "manifest_version": 3,
  "name": "BookBox — Bookmark Toolbox",
  "version": "2.3.1",
  "description": "Your bookmarks, sorted. Organize by real page content with tags, rules, trash, and full-text search. Preview every change first.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "history",
    "contextMenus",
    "tabs",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "omnibox": {
    "keyword": "bb"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BookBox",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Open BookBox"
    },
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save the current page to BookBox"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
